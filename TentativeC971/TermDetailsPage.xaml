<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TentativeC971"
             xmlns:viewmodel="clr-namespace:TentativeC971"
             x:Class="TentativeC971.TermDetailsPage"
             x:DataType="viewmodel:TermDetailsViewModel"
             Title="{Binding ThisTerm.Name}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Add Course"
                     Command="{Binding AddCourseCommand}"
                     CommandParameter="{Binding ThisTerm}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="100,*,50"
          ColumnDefinitions="*,*"
          ColumnSpacing="10">
        <VerticalStackLayout Grid.ColumnSpan="2">
            <Label 
                Text="{Binding WelcomeText}"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                Style="{StaticResource SubHeadline}"/>
            <Label Text="One thing out of the way"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding ThisTerm.Courses}"
                        Grid.Row="1"
                        Grid.ColumnSpan="2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type model:Course}">
                    <Border Margin="10"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:TermDetailsViewModel}}, Path=GoToCourseDetailsCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10">
                            <Border Padding="20,15,20,15"
                                    BackgroundColor="{StaticResource Tertiary}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5,20,20,20"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding Id}"
                                       FontSize="24"
                                       TextColor="White"/>
                            </Border>
                            <Label Text="{Binding Name}"/>
                        </HorizontalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Button Text="Edit Term"
                Grid.Row="2"
                Margin="10,0,0,0"/>
        <Button Text="Delete Term"
                Grid.Row="2"
                Grid.Column="1"
                BackgroundColor="red"
                Margin="0,0,10,0"/>
    </Grid>


</ContentPage>