<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TentativeC971"
             xmlns:viewmodels="clr-namespace:TentativeC971"
             x:Class="TentativeC971.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="My Academic Terms">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="↻"
                                 Color="Black"/>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,75"
          RowSpacing="5"
          ColumnDefinitions="*,*"
          ColumnSpacing="5">

        <CollectionView ItemsSource="{Binding Terms}"
                        Grid.ColumnSpan="2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type model:Term}">
                    <Border BackgroundColor="WhiteSmoke"
                            Padding="0"
                            Grid.Row="0"
                            Margin="5,15,5,15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=GoToTermDetailsCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        
                        <VerticalStackLayout>
                            <FlexLayout BackgroundColor="{StaticResource Primary}"
                                        Padding="30,10,20,10"
                                        JustifyContent="SpaceBetween">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource SubHeadline}"
                                       TextColor="White"
                                       VerticalTextAlignment="Center"/>
                                <Button Text="+ Add Course"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="{StaticResource SecondaryDarkText}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=AddCourseCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="50"/>
                            </FlexLayout>
                           
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Courses}" 
                                                 Padding="10"
                                                 Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="model:Course">
                                        <Border Padding="10,5,10,5">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=GoToCourseDetailsCommand}"
                                                  CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Name}"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            
                            <FlexLayout BackgroundColor="{StaticResource Secondary}"
                                        JustifyContent="Center">
                                <HorizontalStackLayout>
                                    <Label Text="{Binding StartDate}"
                                           TextColor="{StaticResource SecondaryDarkText}"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="-"
                                           TextColor="{StaticResource SecondaryDarkText}"
                                           
                                           Margin="10"
                                           VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding EndDate}"
                                           TextColor="{StaticResource SecondaryDarkText}"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>
                            </FlexLayout>
                            
                            
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <Button Text="Edit Terms"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource SecondaryDarkText}"
                Grid.Row="2"
                Grid.Column="0"
                Margin="5"/>

        <Button Text="Add Term"
                Command="{Binding AddTermCommand}"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="{StaticResource SecondaryDarkText}"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"/>
    </Grid>

</ContentPage>
