<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:TentativeC971"
             xmlns:viewmodels="clr-namespace:TentativeC971"
             x:Class="TentativeC971.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="My Academic Terms">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Add Term" Command="{Binding AddTermCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,75"
          RowSpacing="5">

        <CollectionView ItemsSource="{Binding Terms}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type model:Term}">
                    <Border BackgroundColor="WhiteSmoke"
                            Padding="0"
                            Grid.Row="0"
                            Margin="5,15,5,15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="black"
                                    Offset="5,5"
                                    Radius="10"
                                    Opacity="0.6"/>
                        </Border.Shadow>

                        <VerticalStackLayout>
                            <FlexLayout BackgroundColor="{StaticResource Primary}"
                                        Padding="30,10,20,10"
                                        JustifyContent="SpaceBetween">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource SubHeadline}"
                                       TextColor="White"
                                       VerticalTextAlignment="Center"/>
                                <Button Text="+ Add Course"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="{StaticResource SecondaryDarkText}"
                                        
                                        CornerRadius="50"/>
                            </FlexLayout>
                           
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Courses}" 
                                                 Padding="10"
                                                 Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="model:Course">
                                        <Border Padding="10,5,10,5">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Name}"/>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            
                            <FlexLayout BackgroundColor="{StaticResource Primary}"  
                                        JustifyContent="Center">
                                <HorizontalStackLayout>
                                    <DatePicker TextColor="White"/>
                                    <Label Text=" - "
                                           TextColor="White"
                                           FontSize="24"
                                           VerticalTextAlignment="Center"/>
                                    <DatePicker TextColor="White"/>
                                </HorizontalStackLayout>
                            </FlexLayout>
                            
                            
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>
        
        
        
        
        <Button Text="Useless Button"
                Grid.Row="2"
                Margin="5"/>
    </Grid>

</ContentPage>
